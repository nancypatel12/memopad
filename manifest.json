{
  "manifest_version": 3,
  "name": "Memopad",
  "version": "2.0.0",
  "description": "A seamless, minimalistic tool for capturing tasks and ideas.",
  "permissions": ["storage", "contextMenus", "activeTab"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Memopad"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
